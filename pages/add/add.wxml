<view class="page">
  <!-- 收支切换 -->
  <view class="type-switch">
    <view class="type-btn {{type===0?'active expense':''}}" data-type="0" bindtap="switchType">支出</view>
    <view class="type-btn {{type===1?'active income':''}}" data-type="1" bindtap="switchType">收入</view>
  </view>

  <!-- 金额输入 -->
  <view class="amount-section card">
    <text class="currency">¥</text>
    <input class="amount-input" type="digit" value="{{amount}}" bindinput="onAmountInput"
      placeholder="0.00" placeholder-class="amount-placeholder"
      maxlength="12" style="font-size: {{amountFontSize}}" />
    <view class="amount-line {{type===0?'expense':'income'}}"></view>
  </view>

  <!-- 分类选择 -->
  <view class="category-section card">
    <text class="section-title">选择分类</text>
    <view class="category-grid">
      <view class="category-item {{selectedCategory===item?'selected':''}}"
        wx:for="{{categories}}" wx:key="*this"
        data-category="{{item}}" bindtap="selectCategory">
        <view class="cat-icon {{type===0?'expense':'income'}}">
          {{categoryIcons[item] || '📦'}}
        </view>
        <text class="cat-name">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 预算提示（仅当选择支出分类且已设预算且超阈值时显示） -->
  <view class="budget-hint card" wx:if="{{budgetHint && budgetHint.status!=='ok' && budgetHint.status!=='none'}}">
    <view class="budget-hint-bar-bg">
      <view class="budget-hint-bar-fill budget-hint-{{budgetHint.status}}" style="width:{{budgetHint.pct>100?100:budgetHint.pct}}%"></view>
    </view>
    <view class="budget-hint-text">
      <block wx:if="{{budgetHint.status==='over'}}">⚠ 已超支 {{budgetHint.pct}}%（¥{{budgetHint.spent}} / ¥{{budgetHint.budget}}）</block>
      <block wx:elif="{{budgetHint.status==='warn'}}">本月已用 {{budgetHint.pct}}%，接近预算（¥{{budgetHint.spent}} / ¥{{budgetHint.budget}}）</block>
    </view>
  </view>

  <!-- 日期和备注 -->
  <view class="detail-section card">
    <view class="detail-row">
      <text class="detail-label">日期</text>
      <picker mode="date" value="{{date}}" bindchange="onDateChange">
        <view class="detail-value">
          <text>{{date}}</text>
          <text class="detail-arrow">›</text>
        </view>
      </picker>
    </view>
    <view class="detail-divider"></view>
    <view class="detail-row">
      <text class="detail-label">备注</text>
      <input class="detail-input" value="{{note}}" bindinput="onNoteInput"
        placeholder="添加备注" placeholder-class="detail-placeholder" />
    </view>
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn {{type===0?'expense':'income'}}" bindtap="onSave">
    {{editId?'修改记录':'保存记录'}}
  </view>
</view>
