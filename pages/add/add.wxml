<view class="page">
  <!-- 收支切换 -->
  <view class="type-switcher">
    <view class="type-btn {{type===0?'active expense':''}}" bindtap="switchType" data-type="0">支出</view>
    <view class="type-btn {{type===1?'active income':''}}" bindtap="switchType" data-type="1">收入</view>
  </view>

  <!-- 金额输入 -->
  <view class="amount-section">
    <text class="amount-label">¥</text>
    <input class="amount-input" type="digit" value="{{amount}}" bindinput="onAmountInput" placeholder="0.00" placeholder-class="placeholder" focus="{{true}}" />
  </view>

  <!-- 分类选择 -->
  <view class="section">
    <view class="section-title">分类</view>
    <view class="category-grid">
      <view
        class="category-item {{selectedCategory===item?'selected':''}}"
        wx:for="{{categories}}"
        wx:key="item"
        bindtap="selectCategory" data-category="{{item}}"
      >
        <view class="category-icon {{type===0?'expense':'income'}}">{{categoryIcons[item] || '📦'}}</view>
        <text class="category-name">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 日期 -->
  <view class="section">
    <view class="section-title">日期</view>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="picker-display">{{date}}</view>
    </picker>
  </view>

  <!-- 备注 -->
  <view class="section">
    <view class="section-title">备注</view>
    <input class="note-input" value="{{note}}" bindinput="onNoteInput" placeholder="可选" placeholder-class="placeholder" />
  </view>

  <!-- 保存按钮 -->
  <view class="save-btn {{type===0?'expense':'income'}}" bindtap="onSave">
    保存
  </view>
</view>
