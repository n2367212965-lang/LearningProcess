.page {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #0f0f0f;
}

.type-switcher {
  display: flex;
  background-color: #2a2a2a;
  border-radius: 40rpx;
  padding: 8rpx;
  margin-bottom: 48rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 36rpx;
  font-size: 30rpx;
  color: #9ca3af;
  transition: all 0.2s;
}

.type-btn.active.expense {
  background-color: #ef4444;
  color: #ffffff;
  font-weight: 600;
}

.type-btn.active.income {
  background-color: #f59e0b;
  color: #0f0f0f;
  font-weight: 600;
}

.amount-section {
  margin-bottom: 48rpx;
  background-color: #1a1a1a;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  text-align: center;
}

.amount-label {
  font-size: 40rpx;
  color: #f59e0b;
  font-weight: 700;
}

.amount-input {
  font-size: 64rpx;
  color: #ffffff;
  font-weight: 700;
  text-align: center;
  width: 100%;
  margin-top: 16rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.placeholder {
  color: #4a4a4a;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 28rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: calc(20% - 16rpx);
  padding: 16rpx 0;
  border-radius: 16rpx;
  background-color: #2a2a2a;
}

.category-item.selected {
  background-color: rgba(245, 158, 11, 0.15);
  border: 2rpx solid #f59e0b;
}

.category-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.category-name {
  font-size: 22rpx;
  color: #ffffff;
}

.picker-display {
  background-color: #2a2a2a;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.note-input {
  background-color: #2a2a2a;
  padding: 24rpx 32rpx;
  border-radius: 12rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.save-btn {
  margin-top: 48rpx;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.save-btn.expense {
  background-color: #ef4444;
  color: #ffffff;
}

.save-btn.income {
  background-color: #f59e0b;
  color: #0f0f0f;
}
