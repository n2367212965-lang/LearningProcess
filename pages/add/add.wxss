.page {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-base) 30%);
}

/* ---- 收支切换 ---- */
.type-switch {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-full);
  padding: 6rpx;
  margin-bottom: 32rpx;
  border: 1rpx solid var(--border-subtle);
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--radius-full);
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
  transition: all 0.2s;
}

.type-btn.active.expense {
  background: var(--color-expense-soft);
  color: var(--color-expense);
  box-shadow: 0 0 20rpx rgba(232, 114, 92, 0.15);
}

.type-btn.active.income {
  background: var(--color-income-soft);
  color: var(--color-income);
  box-shadow: 0 0 20rpx rgba(91, 184, 169, 0.15);
}

/* ---- 金额输入 ---- */
.amount-section {
  display: flex;
  align-items: center;
  margin-bottom: 32rpx;
  position: relative;
  padding: 40rpx 36rpx;
}

.currency {
  font-size: 48rpx;
  font-weight: 300;
  color: var(--text-secondary);
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  min-width: 0; /* 允许 flex 子项收缩到内容以下（默认是 min-width: auto） */
  max-width: 100%;
  font-size: 48rpx; /* 偏小：4 位数（9999）也留余量；>4 位由 JS 动态缩 */
  font-weight: 700;
  color: var(--text-primary);
  text-align: right; /* 金额输入右对齐，与光标自然靠右 */
  /* 注意：<input> 是微信原生组件，overflow/text-overflow 对其内部文字无效。
     防溢出只能靠缩小字号 + flex 收缩（min-width:0）。 */
}

.amount-placeholder {
  color: var(--text-tertiary);
  font-size: 40rpx;
  text-align: right;
}

.amount-line {
  position: absolute;
  bottom: 0;
  left: 36rpx;
  right: 36rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.amount-line.expense {
  background: var(--color-expense);
}
.amount-line.income {
  background: var(--color-income);
}

/* ---- 分类选择 ---- */
.category-section {
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 2rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
}

.category-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.category-item.selected .cat-icon {
  border: 2rpx solid var(--accent-gold);
  box-shadow: 0 0 16rpx var(--accent-gold-soft);
}

.category-item.selected .cat-name {
  color: var(--accent-gold);
}

.cat-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 8rpx;
  border: 2rpx solid transparent;
}

.cat-icon.expense {
  background: var(--color-expense-soft);
}
.cat-icon.income {
  background: var(--color-income-soft);
}

.cat-name {
  font-size: 22rpx;
  color: var(--text-secondary);
}

/* ---- 日期和备注 ---- */
.detail-section {
  margin-bottom: 48rpx;
}

.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.detail-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.detail-value {
  display: flex;
  align-items: center;
  color: var(--text-primary);
  font-size: 28rpx;
}

.detail-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
  margin-left: 12rpx;
}

.detail-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--text-primary);
}

.detail-placeholder {
  color: var(--text-tertiary);
}

.detail-divider {
  height: 1rpx;
  background: var(--border-subtle);
}

/* ---- 保存按钮 ---- */
.save-btn {
  padding: 28rpx;
  text-align: center;
  border-radius: var(--radius-lg);
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #ffffff;
}

.save-btn.expense {
  background: linear-gradient(135deg, #e8725c, #d45a44);
  box-shadow: 0 8rpx 32rpx rgba(232, 114, 92, 0.25);
}

.save-btn.income {
  background: linear-gradient(135deg, #5bb8a9, #4aa698);
  box-shadow: 0 8rpx 32rpx rgba(91, 184, 169, 0.25);
}

.save-btn:active {
  opacity: 0.85;
  transform: scale(0.98);
}

/* ---- 预算提示 ---- */
.budget-hint {
  margin-bottom: 24rpx;
  padding: 20rpx 28rpx;
}
.budget-hint-bar-bg {
  height: 12rpx;
  background: var(--border-subtle);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}
.budget-hint-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}
.budget-hint-bar-fill.budget-hint-ok {
  background: var(--color-income);
}
.budget-hint-bar-fill.budget-hint-warn {
  background: #e8a23c;
}
.budget-hint-bar-fill.budget-hint-over {
  background: var(--color-expense);
}
.budget-hint-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  letter-spacing: 1rpx;
}
