.page {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-base) 30%);
}

/* ---- 月份导航 ---- */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.nav-btn {
  padding: 12rpx 32rpx;
}

.nav-arrow {
  font-size: 44rpx;
  color: var(--accent-gold);
  font-weight: 300;
  opacity: 0.8;
}

.month-center {
  display: flex;
  align-items: baseline;
  min-width: 200rpx;
  justify-content: center;
}

.month-year {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

/* ---- 月度概览 ---- */
.summary {
  margin-bottom: 32rpx;
  position: relative;
  overflow: hidden;
}

.summary::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 200rpx;
  height: 200rpx;
  background: radial-gradient(circle, var(--accent-gold-soft), transparent 70%);
  pointer-events: none;
}

.summary-row {
  display: flex;
  align-items: center;
}

.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.summary-amount {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.summary-amount.expense {
  color: var(--color-expense);
}
.summary-amount.income {
  color: var(--color-income);
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(
    180deg,
    transparent,
    var(--border-card),
    transparent
  );
}

/* ---- 每日账单 ---- */
.daily-group {
  margin-bottom: 20rpx;
}

.daily-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 12rpx;
}

.daily-date {
  font-size: 24rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.daily-totals {
  display: flex;
  align-items: center;
}

.daily-expense {
  font-size: 22rpx;
  color: var(--color-expense);
  opacity: 0.7;
  margin-right: 12rpx;
}

.daily-income {
  font-size: 22rpx;
  color: var(--color-income);
  opacity: 0.7;
}

/* ---- 记录条目 ---- */
.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  margin-bottom: 8rpx;
  background: var(--bg-card);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-subtle);
}

.record-item:active {
  background: var(--bg-card-hover);
}

.record-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.record-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.record-icon.expense {
  background: var(--color-expense-soft);
}
.record-icon.income {
  background: var(--color-income-soft);
}

.record-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.record-category {
  font-size: 28rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.record-note {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-amount {
  font-size: 32rpx;
  font-weight: 700;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.record-amount.expense {
  color: var(--color-expense);
}
.record-amount.income {
  color: var(--color-income);
}

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  padding-top: 120rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  display: block;
  letter-spacing: 2rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 12rpx;
}
