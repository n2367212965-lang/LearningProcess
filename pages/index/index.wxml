<view class="page">
  <!-- 月份导航 -->
  <view class="month-nav">
    <view class="nav-btn" bindtap="prevMonth">
      <text class="nav-arrow">‹</text>
    </view>
    <view class="month-center">
      <text class="month-year">{{year}}</text>
      <text class="month-label">{{month}}月</text>
    </view>
    <view class="nav-btn" bindtap="nextMonth">
      <text class="nav-arrow">›</text>
    </view>
  </view>

  <!-- 月度概览 -->
  <view class="summary card">
    <view class="summary-row">
      <view class="summary-item">
        <text class="summary-label">支出</text>
        <text class="summary-amount expense">¥{{expenseStr}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">收入</text>
        <text class="summary-amount income">¥{{incomeStr}}</text>
      </view>
      <view class="summary-divider"></view>
      <view class="summary-item">
        <text class="summary-label">结余</text>
        <text class="summary-amount {{balance>=0?'income':'expense'}}">¥{{balanceStr}}</text>
      </view>
    </view>
  </view>

  <!-- 每日账单 -->
  <view class="daily-list" wx:if="{{dailyList.length>0}}">
    <view wx:for="{{dailyList}}" wx:key="date" class="daily-group">
      <view class="daily-header">
        <text class="daily-date">{{item.dateCN}}</text>
        <view class="daily-totals">
          <text class="daily-expense" wx:if="{{item.expense>0}}">-¥{{item.expenseStr}}</text>
          <text class="daily-income" wx:if="{{item.income>0}}">+¥{{item.incomeStr}}</text>
        </view>
      </view>
      <view class="record-item" wx:for="{{item.items}}" wx:key="id"
        data-id="{{item.id}}" bindlongpress="onLongPressRecord">
        <view class="record-left">
          <view class="record-icon {{item.type===0?'expense':'income'}}">
            {{categoryIcons[item.category] || '📦'}}
          </view>
          <view class="record-info">
            <text class="record-category">{{item.category}}</text>
            <text class="record-note" wx:if="{{item.note}}">{{item.note}}</text>
          </view>
        </view>
        <text class="record-amount {{item.type===0?'expense':'income'}}">
          {{item.type===0?'-':'+'}}¥{{item.amountStr}}
        </text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:if="{{dailyList.length===0}}">
    <view class="empty-icon">📝</view>
    <text class="empty-text">本月暂无记录</text>
    <text class="empty-hint">点击下方「记账」开始记录</text>
  </view>

  <!-- FAB 快速记账：下滑隐藏、上滑显示，点击直达记账 tab -->
  <view class="fab {{!fabVisible ? 'fab--hidden' : ''}}" bindtap="onFabTap" hover-class="fab--press">
    <view class="fab-plus">
      <view class="fab-plus-h"></view>
      <view class="fab-plus-v"></view>
    </view>
  </view>
</view>
