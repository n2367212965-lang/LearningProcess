.page {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-base) 30%);
}

/* ---- 模式切换 ---- */
.mode-switch {
  display: flex;
  background: var(--bg-card);
  border-radius: var(--radius-full);
  padding: 6rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--border-subtle);
}

.mode-btn {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: var(--radius-full);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  letter-spacing: 2rpx;
}

.mode-btn.active {
  background: var(--accent-gold-soft);
  color: var(--accent-gold);
  box-shadow: 0 0 16rpx var(--accent-gold-soft);
}

/* ---- 月份导航 ---- */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.nav-btn {
  padding: 12rpx 32rpx;
}

.nav-arrow {
  font-size: 44rpx;
  color: var(--accent-gold);
  font-weight: 300;
  opacity: 0.8;
}

.month-center {
  display: flex;
  align-items: baseline;
  min-width: 200rpx;
  justify-content: center;
}

.month-year {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-right: 8rpx;
}

.month-label {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: 2rpx;
}

/* ---- 月度汇总 ---- */
.summary {
  margin-bottom: 28rpx;
  position: relative;
  overflow: hidden;
}

.summary::before {
  content: "";
  position: absolute;
  top: -40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: radial-gradient(
    circle,
    var(--color-income-soft),
    transparent 70%
  );
  pointer-events: none;
}

.summary-row {
  display: flex;
  align-items: center;
}
.summary-item {
  flex: 1;
  text-align: center;
}

.summary-label {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.summary-amount {
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.summary-amount.income {
  color: var(--color-income);
}
.summary-amount.expense {
  color: var(--color-expense);
}

.summary-divider {
  width: 1rpx;
  height: 56rpx;
  background: linear-gradient(
    180deg,
    transparent,
    var(--border-card),
    transparent
  );
}

/* ---- 1) 核心 KPI 行 ---- */
.kpi-row {
  display: flex;
  margin-bottom: 28rpx;
}

.kpi-card {
  flex: 1;
  text-align: center;
  padding: 24rpx 12rpx;
  margin: 0 6rpx;
  position: relative;
  overflow: hidden;
}

.kpi-card:first-child {
  margin-left: 0;
}
.kpi-card:last-child {
  margin-right: 0;
}

.kpi-icon {
  font-size: 32rpx;
  display: block;
  margin-bottom: 6rpx;
}

.kpi-value {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.kpi-label {
  font-size: 22rpx;
  display: block;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
  color: var(--text-secondary);
}

.kpi-hint {
  font-size: 18rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 2rpx;
}

/* KPI 颜色变体 */
.kpi-good .kpi-value {
  color: var(--color-income);
}
.kpi-warn .kpi-value {
  color: #e8a23c;
}
.kpi-bad .kpi-value {
  color: var(--color-expense);
}
.kpi-up .kpi-value {
  color: var(--color-expense);
}
.kpi-down .kpi-value {
  color: var(--color-income);
}
.kpi-flat .kpi-value {
  color: var(--text-secondary);
}
.kpi-avg .kpi-value {
  color: var(--accent-gold);
  font-size: 32rpx;
}

/* ---- 2) 储蓄率进度条 ---- */
.progress-card {
  margin-bottom: 28rpx;
}

.progress-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.progress-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.progress-meta {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.progress-bar-bg {
  position: relative;
  height: 20rpx;
  background: var(--border-subtle);
  border-radius: 10rpx;
  overflow: hidden;
}

.progress-bar-fill {
  height: 100%;
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

.progress-bar-fill.progress-good {
  background: linear-gradient(90deg, #51cf66, #2f9e44);
}
.progress-bar-fill.progress-warn {
  background: linear-gradient(90deg, #ffd43b, #e8a23c);
}
.progress-bar-fill.progress-bad {
  background: linear-gradient(90deg, #ff6b6b, #e03131);
}

.progress-mark {
  position: absolute;
  top: -4rpx;
  bottom: -4rpx;
  width: 2rpx;
  background: var(--text-primary);
  opacity: 0.35;
}

.progress-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.progress-status {
  font-weight: 600;
}

/* ---- 通用 section 头 ---- */
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  color: var(--text-secondary);
  font-weight: 500;
  letter-spacing: 1rpx;
  display: block;
}

.section-meta {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.section-legend {
  display: flex;
  align-items: center;
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.legend-dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: 0 4rpx 0 12rpx;
}

.legend-dot.legend-income {
  background: var(--color-income);
}
.legend-dot.legend-expense {
  background: var(--color-expense);
}

/* ---- 3) 趋势柱状图 ---- */
.trend-card {
  margin-bottom: 28rpx;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  padding: 0 4rpx;
  gap: 12rpx;
}

.trend-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.trend-stack {
  width: 80%;
  display: flex;
  flex-direction: column-reverse; /* 支出在下，收入在上 */
  border-radius: 6rpx 6rpx 0 0;
  overflow: hidden;
  min-height: 4rpx;
}

.trend-seg {
  width: 100%;
  transition: all 0.3s;
}

.trend-seg-expense {
  background: linear-gradient(180deg, #ff8787, var(--color-expense));
}

.trend-seg-income {
  background: linear-gradient(180deg, #69db7c, var(--color-income));
}

.trend-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ---- 4) 分类饼图 ---- */
.pie-card {
  margin-bottom: 28rpx;
}

.pie-wrap {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.pie-chart {
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  position: relative;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.pie-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--bg-card);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pie-center-label {
  font-size: 18rpx;
  color: var(--text-tertiary);
  letter-spacing: 1rpx;
}

.pie-center-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-expense);
  margin-top: 2rpx;
}

.pie-legend {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.pie-legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
}

.legend-swatch {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
}

.legend-text {
  flex: 1;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.legend-pct {
  color: var(--text-primary);
  font-weight: 600;
  margin-left: 8rpx;
}

/* ---- 5) 分类排行（Top 5 + 其他） ---- */
.rank-card {
  margin-bottom: 32rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.rank-item:last-child {
  margin-bottom: 0;
}

.rank-left {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.rank-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.rank-icon.expense {
  background: var(--color-expense-soft);
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.rank-name {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.rank-pct {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.rank-bar-bg {
  height: 8rpx;
  background: var(--border-subtle);
  border-radius: 4rpx;
  overflow: hidden;
}

.rank-bar {
  height: 100%;
  background: linear-gradient(
    90deg,
    var(--color-expense),
    rgba(232, 114, 92, 0.4)
  );
  border-radius: 4rpx;
}

.rank-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-expense);
  white-space: nowrap;
  flex-shrink: 0;
}

/* ---- 空状态 ---- */
.empty {
  text-align: center;
  padding-top: 80rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
  display: block;
  letter-spacing: 2rpx;
}

.empty-hint {
  font-size: 24rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 12rpx;
}

/* ---- 预算警告 ---- */
.budget-warn-card {
  margin-bottom: 28rpx;
}

.budget-warn-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.budget-warn-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--bg-card-hover);
  border-radius: var(--radius-md);
  border: 1rpx solid var(--border-subtle);
  border-left: 6rpx solid var(--color-income);
}
.budget-warn-warn {
  border-left-color: #e8a23c;
}
.budget-warn-over {
  border-left-color: var(--color-expense);
  background: var(--color-expense-soft);
}

.budget-warn-left {
  display: flex;
  align-items: center;
}
.budget-warn-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}
.budget-warn-cat {
  font-size: 26rpx;
  color: var(--text-primary);
  font-weight: 500;
}

.budget-warn-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.budget-warn-amount {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.budget-warn-pct {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.budget-warn-over .budget-warn-pct {
  color: var(--color-expense);
}
.budget-warn-warn .budget-warn-pct {
  color: #e8a23c;
}
