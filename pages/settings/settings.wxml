<view class="page">
  <!-- 支出分类管理 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">支出分类</text>
      <view class="add-btn" bindtap="onAddExpense">+ 新增</view>
    </view>
    <view class="category-list">
      <view class="cat-item" wx:for="{{expenseCategories}}" wx:key="item">
        <text class="cat-name">{{item}}</text>
        <text class="cat-del" bindtap="onDeleteCategory" data-type="0" data-name="{{item}}">删除</text>
      </view>
    </view>
    <view class="reset-btn" bindtap="onResetExpense">重置为默认分类</view>
  </view>

  <!-- 收入分类管理 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">收入分类</text>
      <view class="add-btn" bindtap="onAddIncome">+ 新增</view>
    </view>
    <view class="category-list">
      <view class="cat-item" wx:for="{{incomeCategories}}" wx:key="item">
        <text class="cat-name">{{item}}</text>
        <text class="cat-del" bindtap="onDeleteCategory" data-type="1" data-name="{{item}}">删除</text>
      </view>
    </view>
    <view class="reset-btn" bindtap="onResetIncome">重置为默认分类</view>
  </view>

  <!-- 数据管理 -->
  <view class="card">
    <view class="section-header">
      <text class="section-title">数据管理</text>
    </view>
    <view class="menu-item" bindtap="onClearData">
      <text class="menu-text">清除所有数据</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>
</view>
