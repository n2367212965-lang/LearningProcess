.page {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-base) 30%);
}

/* ---- 区块 ---- */
.section {
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.section-dot.expense {
  background: var(--color-expense);
}
.section-dot.income {
  background: var(--color-income);
}
.section-dot.danger {
  background: var(--color-expense);
}

.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-action {
  font-size: 22rpx;
  color: var(--accent-gold);
  letter-spacing: 1rpx;
}

/* ---- 分类标签（堆叠布局） ---- */
.cat-tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.cat-tag {
  display: flex;
  align-items: center;
  background: var(--bg-card-hover);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-full);
  padding: 8rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.cat-emoji {
  font-size: 24rpx;
  margin-right: 6rpx;
}

.cat-tag-name {
  font-size: 24rpx;
  color: var(--text-primary);
  margin-right: 4rpx;
}

.cat-tag-del {
  font-size: 24rpx;
  color: var(--color-expense);
  opacity: 0.6;
  padding: 0 4rpx;
  line-height: 1;
}

.cat-tag-del:active {
  opacity: 1;
}

.reset-link {
  font-size: 20rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding-top: 4rpx;
  letter-spacing: 1rpx;
}

/* ---- 危险操作区 ---- */
.danger-zone {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: var(--color-expense-soft);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(232, 114, 92, 0.2);
}

.danger-zone:active {
  background: rgba(232, 114, 92, 0.18);
}

.danger-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: rgba(232, 114, 92, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.danger-icon {
  font-size: 28rpx;
}

.danger-info {
  flex: 1;
  min-width: 0;
}

.danger-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-expense);
  display: block;
}

.danger-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 2rpx;
}

.danger-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* ---- 弹窗 ---- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 560rpx;
  background: var(--bg-base);
  border-radius: var(--radius-lg);
  padding: 40rpx 36rpx;
  border: 1rpx solid var(--border-card);
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 28rpx;
}

.modal-input {
  background: var(--bg-card);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 28rpx;
  height: 72rpx;
  box-sizing: border-box;
}

.modal-placeholder {
  color: var(--text-tertiary);
}

.modal-btns {
  display: flex;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.modal-btn.cancel {
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-subtle);
  margin-right: 16rpx;
}

.modal-btn.confirm {
  background: var(--accent-gold);
  color: var(--bg-deep);
}

.modal-btn:active {
  opacity: 0.85;
}

/* ---- 预算徽章 ---- */
.cat-tag-budget {
  font-size: 20rpx;
  color: var(--accent-gold);
  margin-left: 6rpx;
  letter-spacing: 1rpx;
}
.cat-tag-budget-btn {
  font-size: 20rpx;
  color: var(--text-tertiary);
  margin-left: 8rpx;
  padding: 0 10rpx;
  border: 1rpx solid var(--border-subtle);
  border-radius: 12rpx;
}
.cat-tag-budget-btn:active {
  color: var(--accent-gold);
  border-color: var(--accent-gold);
}

/* ---- 数据备份区 ---- */
.section-dot.safe {
  background: var(--color-income);
}
.safe-zone {
  display: flex;
  align-items: center;
  padding: 20rpx 16rpx;
  background: var(--color-income-soft);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(91, 184, 169, 0.2);
}
.safe-zone:active {
  opacity: 0.85;
}
.safe-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-sm);
  background: rgba(91, 184, 169, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}
.safe-icon {
  font-size: 28rpx;
}
.safe-info {
  flex: 1;
  min-width: 0;
}
.safe-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-income);
  display: block;
}
.safe-desc {
  font-size: 20rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 2rpx;
}
.safe-arrow {
  font-size: 32rpx;
  color: var(--text-tertiary);
}
