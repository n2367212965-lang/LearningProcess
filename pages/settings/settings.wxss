.page {
  padding: 32rpx;
  min-height: 100vh;
  background-color: #0f0f0f;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

.add-btn {
  font-size: 26rpx;
  color: #f59e0b;
  padding: 8rpx 20rpx;
  border: 2rpx solid #f59e0b;
  border-radius: 8rpx;
}

.category-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  background-color: #1a1a1a;
  border-radius: 8rpx;
  padding: 12rpx 20rpx;
}

.cat-name {
  font-size: 26rpx;
  color: #ffffff;
  margin-right: 16rpx;
}

.cat-del {
  font-size: 22rpx;
  color: #ef4444;
}

.reset-btn {
  text-align: center;
  font-size: 24rpx;
  color: #9ca3af;
  padding: 20rpx 0 0;
  margin-top: 16rpx;
  border-top: 2rpx solid #1a1a1a;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #1a1a1a;
}

.menu-text {
  font-size: 28rpx;
  color: #ef4444;
}

.menu-arrow {
  font-size: 36rpx;
  color: #6b7280;
}
