.page {
  padding: 32rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, var(--bg-deep) 0%, var(--bg-base) 30%);
}

/* ---- 区块 ---- */
.section {
  margin-bottom: 28rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
}

.section-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.section-dot.expense {
  background: var(--color-expense);
}
.section-dot.income {
  background: var(--color-income);
}
.section-dot.danger {
  background: var(--color-expense);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: 1rpx;
}

.section-action {
  font-size: 24rpx;
  color: var(--accent-gold);
  letter-spacing: 1rpx;
}

/* ---- 分类列表 ---- */
.cat-list {
  margin-bottom: 20rpx;
}

.cat-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.cat-item:last-child {
  border-bottom: none;
}

.cat-emoji {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.cat-name {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-primary);
}

.cat-delete {
  font-size: 22rpx;
  color: var(--color-expense);
  opacity: 0.7;
  padding: 4rpx 12rpx;
}

.cat-delete:active {
  opacity: 1;
}

.reset-link {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-align: center;
  padding-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ---- 危险操作区 ---- */
.danger-zone {
  display: flex;
  align-items: center;
  padding: 24rpx 20rpx;
  background: var(--color-expense-soft);
  border-radius: var(--radius-md);
  border: 1rpx solid rgba(232, 114, 92, 0.2);
}

.danger-zone:active {
  background: rgba(232, 114, 92, 0.18);
}

.danger-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: var(--radius-sm);
  background: rgba(232, 114, 92, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.danger-icon {
  font-size: 32rpx;
}

.danger-info {
  flex: 1;
  min-width: 0;
}

.danger-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-expense);
  display: block;
}

.danger-desc {
  font-size: 22rpx;
  color: var(--text-tertiary);
  display: block;
  margin-top: 4rpx;
}

.danger-arrow {
  font-size: 36rpx;
  color: var(--text-tertiary);
}

/* ---- 弹窗 ---- */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  visibility: hidden;
  transition: all 0.2s;
}

.modal-mask.show {
  opacity: 1;
  visibility: visible;
}

.modal-content {
  width: 560rpx;
  background: var(--bg-base);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  border: 1rpx solid var(--border-card);
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  display: block;
  text-align: center;
  margin-bottom: 32rpx;
}

.modal-input {
  background: var(--bg-card);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-primary);
  margin-bottom: 32rpx;
}

.modal-placeholder {
  color: var(--text-tertiary);
}

.modal-btns {
  display: flex;
  margin: 0 -8rpx;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 500;
  margin: 0 8rpx;
  letter-spacing: 2rpx;
}

.modal-btn.cancel {
  background: var(--bg-card);
  color: var(--text-secondary);
  border: 1rpx solid var(--border-subtle);
}

.modal-btn.confirm {
  background: var(--accent-gold);
  color: var(--bg-deep);
}

.modal-btn:active {
  opacity: 0.85;
}
