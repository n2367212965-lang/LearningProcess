page {
  background-color: #0f0f0f;
  color: #ffffff;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
}

.card {
  background-color: #2a2a2a;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.text-primary { color: #ffffff; }
.text-secondary { color: #9ca3af; }
.text-income { color: #f59e0b; }
.text-expense { color: #ef4444; }

.btn-primary {
  background-color: #f59e0b;
  color: #0f0f0f;
  border-radius: 40rpx;
  padding: 24rpx 48rpx;
  font-weight: 600;
  text-align: center;
}

.btn-primary:active {
  opacity: 0.8;
}
