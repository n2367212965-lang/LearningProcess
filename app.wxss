/* Midnight Luxe — 设计令牌系统 */
page {
  --bg-deep: #080b14;
  --bg-base: #0c1021;
  --bg-card: rgba(20, 24, 45, 0.92);
  --bg-card-hover: rgba(28, 32, 56, 0.95);

  --accent-gold: #c9a87c;
  --accent-gold-soft: rgba(201, 168, 124, 0.12);

  --color-expense: #e8725c;
  --color-expense-soft: rgba(232, 114, 92, 0.12);
  --color-income: #5bb8a9;
  --color-income-soft: rgba(91, 184, 169, 0.12);

  --text-primary: #e8e4df;
  --text-secondary: #8a8697;
  --text-tertiary: #514f5e;

  --border-card: rgba(201, 168, 124, 0.1);
  --border-subtle: rgba(201, 168, 124, 0.06);

  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-full: 999rpx;

  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-primary);
  background: var(--bg-deep);
}

/* ---- 通用卡片 ---- */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 36rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 0 var(--border-card);
}

/* ---- 通用按钮 ---- */
.btn-primary {
  background: var(--accent-gold);
  color: var(--bg-deep);
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 24rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.btn-primary:active {
  opacity: 0.85;
}
